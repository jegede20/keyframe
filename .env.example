# Keyframe environment variables (Vite — VITE_ prefix required)
#
# Groq API key used as the app's built-in key.
# Get a free key at https://console.groq.com/keys
# Users can override this in Settings with their own key (stored only on their device).
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Note: this key is bundled into the client build, so it is visible to anyone who
# inspects the JS bundle. Users can always supply their own key in Settings.
