# Keyframe environment variables (Vite — VITE_ prefix required)
#
# The app's Groq key — get a free one at https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Note: this key is bundled into the client build, so anyone can read it out of
# the JS bundle. Keyframe keeps it working within Groq's free-tier limits
# (~8,000 tokens per minute per model) and falls back to a second model on 429.
